<PropertyList>
  <meta>
    <file-type type="string">FlightGear add-on menu bar items</file-type>
    <format-version type="int">1</format-version>
  </meta>

  <menubar-items>
    <menu>
      <label>Air Cargo Simulator</label>
      <enabled type="bool">true</enabled>

      <item>
        <label>Current Delivery</label>
        <binding>
          <command>dialog-show</command>
          <dialog-name>current-delivery</dialog-name>
        </binding>
      </item>

      <item>
        <label>Local Deliveries</label>
        <binding>
          <command>dialog-show</command>
          <dialog-name>local-deliveries</dialog-name>
        </binding>
      </item>

      <item>
        <label>Statistics</label>
        <binding>
          <command>dialog-show</command>
          <dialog-name>statistics</dialog-name>
        </binding>
      </item>

      <item>
        <label>Help</label>
        <binding>
          <command>dialog-show</command>
          <dialog-name>help</dialog-name>
        </binding>
      </item>

      <item>
        <label>About</label>
        <binding>
          <command>dialog-show</command>
          <dialog-name>about</dialog-name>
        </binding>
      </item>

    </menu>
  </menubar-items>
</PropertyList>
