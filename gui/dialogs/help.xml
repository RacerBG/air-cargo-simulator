<PropertyList>
  <name>help</name>
  <width>450</width>
  <height>250</height>
  <modal>false</modal>
  <draggable>true</draggable>
  <layout>vbox</layout>

  <!-- Header -->
  <group>
    <layout>hbox</layout>

    <empty>
      <stretch>true</stretch>
    </empty>

    <text>
      <label>Help</label>
    </text>

    <empty>
      <stretch>true</stretch>
    </empty>
  </group>
  
  <hrule/>

  <!-- Main content -->
  <group>
    <layout>vbox</layout>

    <empty>
      <stretch>true</stretch>
    </empty>
    
    <text>
        <label>In order to commence any cargo operations:</label>
    </text>
    
    <text>
        <label></label>
    </text>
    
    <text>
        <label>> You must be in the vicinity of an airport.</label>
    </text>
    
    <text>
        <label>> The aircraft must be on the ground and completely stationary.</label>
    </text>
    
    <text>
        <label>> The engine must not be running.</label>
    </text>
    
    <text>
        <label></label>
    </text>

    <empty>
      <stretch>true</stretch>
    </empty>
  </group>
  
  <hrule/>

  <!-- Footer -->
  <group>
    <layout>hbox</layout>

    <empty>
      <stretch>true</stretch>
    </empty>

    <button>
      <legend>Close</legend>
      <binding>
        <command>dialog-close</command>
      </binding>
    </button>

    <empty>
      <stretch>true</stretch>
    </empty>
  </group>
</PropertyList>
