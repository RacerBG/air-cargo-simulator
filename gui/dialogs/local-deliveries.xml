<PropertyList>
  <name>local-deliveries</name>
  <width>900</width>
  <height>750</height>
  <modal>false</modal>
  <draggable>true</draggable>
  <layout>vbox</layout>

  <nasal>
    <open>
      acs.populateDialog(cmdarg());
    </open>
  </nasal>

  <!-- Header -->
  <group>
    <layout>hbox</layout>

    <empty>
      <stretch>true</stretch>
    </empty>

    <text>
      <label>Local Deliveries</label>
    </text>

    <empty>
      <stretch>true</stretch>
    </empty>
  </group>

  <hrule/>

  <!-- Main content -->
  <group>
    <layout>vbox</layout>

    <!-- Delivery list -->
    <group>
      <layout>vbox</layout>
    </group>
  </group>

  <hrule/>

<!-- Footer -->
<group>
    <layout>hbox</layout>

    <empty>
        <stretch>true</stretch>
    </empty>

    <button>
        <legend>Close</legend>
        <equal>true</equal>
        <key>Esc</key>
        <default>true</default>
        <binding>
            <command>dialog-close</command>
        </binding>
    </button>

    <empty>
        <stretch>true</stretch>
    </empty>
</group>
</PropertyList>
